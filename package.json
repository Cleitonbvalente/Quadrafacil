{
  "name": "quadrafacil",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "api": "npm --prefix backend start",
    "api:dev": "npm --prefix backend run dev",
    "api:instalar": "npm --prefix backend install",
    "api:testes": "npm --prefix backend test",
    "web:gerar": "expo export --platform web --output-dir dist",
    "apresentacao": "npm run web:gerar && npm run api",
    "tunel": "node scripts/tunel.js"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.2.4",
    "qrcode-terminal": "^0.12.0",
    "typescript": "~6.0.3"
  }
}
